---
import '../styles/blog.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Blog Naufal — catatan, tutorial, dan pengalaman tentang jaringan, robotik, dan web.' } = Astro.props;
const pageTitle = title.includes('Naufal') ? title : `${title} | Naufal`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080C1E" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/PORTOFOLIO/assets/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;700&family=Unbounded:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/PORTOFOLIO/css/style.css" />
    <link rel="stylesheet" href="/PORTOFOLIO/css/sections.css" />
    <link rel="stylesheet" href="/PORTOFOLIO/css/features.css" />
    <title>{pageTitle}</title>
  </head>
  <body class="blog-page">
    <a class="skip" href="#main">Lompat ke isi</a>

    <header class="nav">
      <div class="wrap nav__inner">
        <a class="brand" href="/PORTOFOLIO/">
          <svg aria-hidden="true" viewBox="0 0 32 32" width="34" height="34">
            <circle cx="16" cy="16" r="15" fill="#F4F7FC" />
            <rect x="6" y="9" width="20" height="14" rx="7" fill="#141B34" />
            <circle class="t-acc" cx="21" cy="14" r="2" />
          </svg>
          <span>Naufal</span>
        </a>
        <nav id="menu" class="nav__menu" aria-label="Navigasi utama">
          <a href="/PORTOFOLIO/">Home</a>
          <a href="/PORTOFOLIO/#tentang">Tentang</a>
          <a href="/PORTOFOLIO/#proyek">Proyek</a>
          <a href="/PORTOFOLIO/#keahlian">Keahlian</a>
          <a href="/PORTOFOLIO/#perjalanan">Perjalanan</a>
          <a href="/PORTOFOLIO/#prestasi">Prestasi</a>
          <a href="/PORTOFOLIO/#game">Game</a>
          <a href="/PORTOFOLIO/blog/" aria-current="true">Blog</a>
          <a class="btn btn--line" href="/PORTOFOLIO/#kontak">Hubungi saya</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap section" style="padding-top:0; padding-bottom:96px;">
      <slot />
    </main>

    <footer class="wrap site-footer" style="margin-top:0;">
      <div class="site-footer__bottom">
        <p>© <span>{new Date().getFullYear()}</span> Muhammad Naufal Athaillah Ghani. Ditulis dengan rasa ingin tahu.</p>
        <a class="link" href="/PORTOFOLIO/blog/">Log perjalanan</a>
      </div>
    </footer>

    <style>
      .blog-page { padding: 0; }
      .wrap { max-width: 1120px; }
      .skip {
        position: absolute; left: -999px; top: 0;
      }
      .skip:focus { left: 12px; top: 12px; position: fixed; z-index: 9999; background: var(--accent); color: var(--accent-ink); padding: 8px 14px; border-radius: 8px; }
    </style>
  </body>
</html>
