---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="Blog | Naufal" description="Catatan, tutorial, dan pengalaman tentang jaringan, robotik, dan web.">
  <div class="blog-header">
    <h1>Blog</h1>
    <p class="lede">
      Catatan perjalanan belajar: jaringan komputer, robotika, pengembangan web, dan proyek-proyek SMK.
      Tulisan baru menyusul.
    </p>
  </div>

  {posts.length === 0 ? (
    <div class="blog-empty" style="margin-top:48px; color:var(--muted)">
      <p>Belum ada tulisan. Cek lagi nanti — tulisan pertama sedang dalam perjalanan.</p>
    </div>
  ) : (
    <div class="blog-list">
      {posts.map((post) => (
        <a class="blog-card" href={`/PORTOFOLIO/blog/${post.slug}/`}>
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <h2>{post.data.title}</h2>
          <p>{post.data.excerpt}</p>
          {post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </a>
      ))}
    </div>
  )}
</Base>
